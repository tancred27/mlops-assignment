{
    "title": "Heart Disease API",
    "uid": "heart-api",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "5s",
    "time": {
        "from": "now-15m",
        "to": "now"
    },
    "panels": [
        {
            "id": 1,
            "type": "timeseries",
            "title": "Request rate by endpoint",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps"
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (path) (rate(http_requests_total[1m]))",
                    "legendFormat": "{{path}}"
                }
            ]
        },
        {
            "id": 2,
            "type": "timeseries",
            "title": "Latency of /predict (p50 and p95)",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{path=\"/predict\"}[1m])))",
                    "legendFormat": "p50"
                },
                {
                    "refId": "B",
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{path=\"/predict\"}[1m])))",
                    "legendFormat": "p95"
                }
            ]
        },
        {
            "id": 3,
            "type": "timeseries",
            "title": "Predictions by class (last 5 min)",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 0,
                "y": 8,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (prediction) (increase(predictions_total[5m]))",
                    "legendFormat": "class {{prediction}}"
                }
            ]
        },
        {
            "id": 4,
            "type": "timeseries",
            "title": "Error responses (4xx and 5xx)",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 12,
                "y": 8,
                "w": 12,
                "h": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps"
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (status) (rate(http_requests_total{status=~\"4..|5..\"}[1m]))",
                    "legendFormat": "HTTP {{status}}"
                }
            ]
        },
        {
            "id": 5,
            "type": "stat",
            "title": "Total requests since start",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 0,
                "y": 16,
                "w": 8,
                "h": 4
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(http_requests_total)"
                }
            ]
        }
    ]
}